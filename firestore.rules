rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function incoming() {
      return request.resource.data;
    }

    function isValidUserCode(code) {
      return code is string && code.size() == 6 && code.matches('^[0-9]+$');
    }

    function isValidVocabulary(vocab) {
      return vocab.german is string && vocab.german.size() > 0 && vocab.german.size() <= 1000 &&
             vocab.vietnamese is string && vocab.vietnamese.size() > 0 && vocab.vietnamese.size() <= 1000;
    }

    function isValidGrammar(grammar) {
      return grammar.title is string && grammar.title.size() > 0 && grammar.title.size() <= 500 &&
             grammar.explanation is string && grammar.explanation.size() <= 5000 &&
             grammar.examples is list && grammar.examples.size() <= 50;
    }

    function isValidLesson(data) {
      return isValidUserCode(data.userId) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.vocabulary is list && data.vocabulary.size() <= 200 &&
             data.grammar is list && data.grammar.size() <= 100;
    }

    match /lessons/{lessonId} {
      // Allow read/write if the userId is a valid 6-digit code
      // Security is minimal but matches the user's specific request for ID-only login
      allow list: if isValidUserCode(resource.data.userId);
      allow get: if isValidUserCode(resource.data.userId);
      
      allow create: if isValidLesson(incoming()) &&
                    incoming().createdAt == request.time;
      
      allow update: if isValidLesson(incoming()) &&
                    incoming().userId == resource.data.userId &&
                    incoming().createdAt == resource.data.createdAt &&
                    incoming().updatedAt == request.time;
      
      allow delete: if isValidUserCode(resource.data.userId);
    }
  }
}
